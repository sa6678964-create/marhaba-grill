# .env.example

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key-for-client
SUPABASE_SERVICE_ROLE_KEY=service-role-key-ONLY-on-server

# Stripe (Test Keys)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# Other
ADMIN_JWT_SECRET=change-me-to-a-random-string
DEFAULT_DELIVERY_FEE=3.5
CURRENCY=eur

# Optional: if you prefer direct Postgres connection for transactional writes
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
